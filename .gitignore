# Patient-level data: never committed (raw data stays on the local machine only)
*.xlsx
*.xls
*.csv
# ...except aggregate result tables generated by the analysis
!clinical-screening-and-analysis/analysis/output/*.xlsx
!clinical-screening-and-analysis/analysis/output/figures/normality_tests.csv
# per-patient outputs (cluster assignments, individual case rows)
**/output/private/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Run logs
**/output_log*.txt
